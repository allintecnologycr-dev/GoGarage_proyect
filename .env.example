# Copiar a .env y completar. Nunca commitear el archivo .env real.

DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres administrado en Supabase (producción) o Postgres/sqlite local (desarrollo).
# Formato: postgres://usuario:password@host:puerto/nombre_db
DATABASE_URL=

TIME_ZONE=America/Costa_Rica

CORS_ALLOWED_ORIGINS=http://localhost:3000

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Supabase Storage (S3-compatible) para fotos de EvidenciaFoto.
# Si SUPABASE_STORAGE_BUCKET_NAME queda vacío, en desarrollo las fotos se
# guardan localmente en MEDIA_ROOT en vez de subirse a Supabase.
# Endpoint típico: https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_STORAGE_BUCKET_NAME=
SUPABASE_S3_ENDPOINT_URL=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION_NAME=us-east-1
